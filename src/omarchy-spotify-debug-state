#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SPOTIFY_PLAYER=${SPOTIFY_PLAYER:-$HOME/.local/opt/spotify-player-0.24.1/usr/bin/spotify_player}
SPOTIFY_CONFIG_FOLDER=${SPOTIFY_CONFIG_FOLDER:-$HOME/.config/spotify-player}
SPOTIFY_CACHE_FOLDER=${SPOTIFY_CACHE_FOLDER:-$HOME/.cache/spotify-player}
SPOTIFY_MEDIA_KEY=${SPOTIFY_MEDIA_KEY:-$SCRIPT_DIR/omarchy-spotify-media-key}
SNAPSHOT=${1:-/tmp/spotify-debug-state-$(date +%Y%m%d-%H%M%S).txt}

write_section() {
  printf '\n## %s\n' "$1"
}

run_readonly() {
  printf '$ %s\n' "$*"
  "$@" 2>&1 || true
}

spotify_playback() {
  local output
  output="$(timeout 10s "$SPOTIFY_PLAYER" --config-folder "$SPOTIFY_CONFIG_FOLDER" --cache-folder "$SPOTIFY_CACHE_FOLDER" get key playback 2>&1 || true)"
  jq '{is_playing, currently_playing_type, item_type:.item.type, item_null:(.item == null), id:.item.id, track:.item.name, context:.context.uri, progress_ms, device:.device.name}' <<<"$output" 2>/dev/null || printf '%s\n' "$output"
}

latest_spotify_log() {
  [[ -d "$SPOTIFY_CACHE_FOLDER" ]] || return 0
  find "$SPOTIFY_CACHE_FOLDER" -maxdepth 1 -name 'spotify-player-*.log' -printf '%T@ %p\n' 2>/dev/null |
    sort -nr | head -n 1 | cut -d' ' -f2-
}

{
  write_section "time"
  date -Is

  write_section "service"
  run_readonly systemctl --user --no-pager --full status spotify-player.service
  run_readonly "$SPOTIFY_PLAYER" --version

  write_section "processes"
  run_readonly pgrep -a spotify_player

  write_section "players"
  run_readonly playerctl -l
  run_readonly playerctl -p spotify_player status
  run_readonly playerctl -p spotify_player metadata --format '{{status}}|{{title}}|{{artist}}|{{mpris:trackid}}|{{position}}'

  write_section "playback-json"
  spotify_playback

  write_section "spotify-media-key-dry-run"
  for command in play-pause next previous volume-up volume-down; do
    SPOTIFY_MEDIA_KEY_DRY_RUN=1 "$SPOTIFY_MEDIA_KEY" "$command" 2>&1 || true
  done

  write_section "hypr-spotify-windows"
  hyprctl clients -j 2>/dev/null | jq -r '.[] | select((.class|test("spotify|Spotify"; "i")) or (.title|test("spotify|Spotify"; "i"))) | [.address,.class,.title,.pid] | @tsv' || true

  write_section "latest-log"
  latest_log="$(latest_spotify_log)"
  printf '%s\n' "${latest_log:-<none>}"
  if [[ -n "${latest_log:-}" ]]; then
    rg -a -n 'GetCurrentPlayback.*Bad Request|Bad Request|Failed to handle socket request|Failed to handle client request|Encountered an error|Got a new player event|ERROR|WARN' "$latest_log" | tail -n 120 || true
  fi
} >"$SNAPSHOT"

printf '%s\n' "$SNAPSHOT"
