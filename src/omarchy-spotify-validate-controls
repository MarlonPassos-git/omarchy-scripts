#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SPOTIFY_PLAYER=${SPOTIFY_PLAYER:-$HOME/.local/opt/spotify-player-0.24.0/usr/bin/spotify_player}
SPOTIFY_CONFIG_FOLDER=${SPOTIFY_CONFIG_FOLDER:-$HOME/.config/spotify-player}
SPOTIFY_CACHE_FOLDER=${SPOTIFY_CACHE_FOLDER:-$HOME/.cache/spotify-player}
SPOTIFY_MEDIA_KEY=${SPOTIFY_MEDIA_KEY:-$SCRIPT_DIR/omarchy-spotify-media-key}
SPOTIFY_VALIDATE_WAIT_SECONDS=${SPOTIFY_VALIDATE_WAIT_SECONDS:-10}
SPOTIFY_VALIDATE_POLL_SECONDS=${SPOTIFY_VALIDATE_POLL_SECONDS:-2}
FAILURES=0
LATEST_LOG=""
LOG_START_LINE=0

fail() {
  printf 'FAIL %s\n' "$1"
  FAILURES=$((FAILURES + 1))
}

pass() {
  printf 'PASS %s\n' "$1"
}

playback_json() {
  timeout 10s "$SPOTIFY_PLAYER" --config-folder "$SPOTIFY_CONFIG_FOLDER" --cache-folder "$SPOTIFY_CACHE_FOLDER" get key playback 2>/dev/null || printf '{}'
}

latest_spotify_log() {
  [[ -d "$SPOTIFY_CACHE_FOLDER" ]] || return 0
  find "$SPOTIFY_CACHE_FOLDER" -maxdepth 1 -name 'spotify-player-*.log' -printf '%T@ %p\n' 2>/dev/null |
    sort -nr | head -n 1 | cut -d' ' -f2-
}

mark_log_position() {
  LATEST_LOG="$(latest_spotify_log)"
  [[ -n "$LATEST_LOG" && -f "$LATEST_LOG" ]] || return 0
  LOG_START_LINE="$(wc -l <"$LATEST_LOG")"
}

recent_log_errors() {
  [[ -n "$LATEST_LOG" && -f "$LATEST_LOG" ]] || return 1
  tail -n +"$((LOG_START_LINE + 1))" "$LATEST_LOG" |
    rg -a 'GetCurrentPlayback.*Bad Request|Failed to handle a player request|Too Many Requests'
}

playback_value() {
  playback_json | jq -r "$1"
}

is_playing() {
  playback_value '.is_playing'
}

volume_percent() {
  playback_value '.device.volume_percent // empty'
}

state_line() {
  playback_json | jq -r '[.device.name, .device.volume_percent, .is_playing, .currently_playing_type, .item.type, .item.name] | @tsv'
}

dry_run() {
  SPOTIFY_MEDIA_KEY_DRY_RUN=1 "$SPOTIFY_MEDIA_KEY" "$1" 2>&1 || true
}

expect_contains() {
  [[ "$1" == *"$2"* ]] && pass "$3" || fail "$3 expected <$2> in <$1>"
}

expect_not_contains() {
  [[ "$1" != *"$2"* ]] && pass "$3" || fail "$3 unexpected <$2> in <$1>"
}

wait_for_playing() {
  local expected="$1"
  local current
  for _ in $(seq 1 "$((SPOTIFY_VALIDATE_WAIT_SECONDS / SPOTIFY_VALIDATE_POLL_SECONDS))"); do
    current="$(is_playing)"
    [[ "$current" == "$expected" ]] && return 0
    sleep "$SPOTIFY_VALIDATE_POLL_SECONDS"
  done
  return 1
}

check_daemon() {
  local count
  count="$(pgrep -fc '(^|/)spotify_player --daemon$' || true)"
  [[ "$count" == "1" ]] && pass "one daemon" || fail "expected one daemon, got $count"
}

check_playback_loaded() {
  local item device
  item="$(playback_value '.item != null')"
  device="$(playback_value '.device.name // empty')"
  [[ "$item" == "true" ]] && pass "playback item loaded" || fail "playback item missing"
  [[ "$device" == "spotify-player" ]] && pass "active device spotify-player" || fail "unexpected device <$device>"
}

check_routes() {
  local play volume
  play="$(dry_run play-pause)"
  volume="$(dry_run volume-up)"
  expect_contains "$play" 'playback play-pause' "play-pause uses spotify_player CLI"
  expect_not_contains "$play" 'spotify-player-tui' "play-pause avoids TUI socket"
  expect_contains "$volume" 'playback volume' "volume uses spotify_player CLI"
  expect_not_contains "$volume" 'pactl' "volume avoids PipeWire stream"
}

check_play_pause() {
  local before after restore
  before="$(is_playing)"
  "$SPOTIFY_MEDIA_KEY" play-pause >/dev/null 2>&1 || fail "play-pause command failed"
  after=false
  [[ "$before" == "false" ]] && after=true
  wait_for_playing "$after" && pass "play-pause toggles to $after" || fail "play-pause did not toggle from $before"
  "$SPOTIFY_MEDIA_KEY" play-pause >/dev/null 2>&1 || fail "play-pause restore command failed"
  restore="$before"
  wait_for_playing "$restore" && pass "play-pause restores to $restore" || fail "play-pause did not restore to $restore"
}

volume_target() {
  local current="$1"
  local direction="$2"
  [[ "$direction" == "up" ]] && current=$((current + 5)) || current=$((current - 5))
  (( current < 0 )) && current=0
  (( current > 100 )) && current=100
  printf '%s\n' "$current"
}

check_volume() {
  local before down up expected_down expected_up
  before="$(volume_percent)"
  [[ "$before" =~ ^[0-9]+$ ]] || { fail "volume is not numeric <$before>"; return; }
  expected_down="$(volume_target "$before" down)"
  "$SPOTIFY_MEDIA_KEY" volume-down >/dev/null 2>&1 || fail "volume-down command failed"
  sleep "$SPOTIFY_VALIDATE_WAIT_SECONDS"
  down="$(volume_percent)"
  [[ "$down" == "$expected_down" ]] && pass "volume-down $before->$down" || fail "volume-down expected $expected_down got $down"
  expected_up="$(volume_target "$down" up)"
  "$SPOTIFY_MEDIA_KEY" volume-up >/dev/null 2>&1 || fail "volume-up command failed"
  sleep "$SPOTIFY_VALIDATE_WAIT_SECONDS"
  up="$(volume_percent)"
  [[ "$up" == "$expected_up" ]] && pass "volume-up $down->$up" || fail "volume-up expected $expected_up got $up"
}

check_recent_log_errors() {
  local errors

  errors="$(recent_log_errors || true)"
  [[ -z "$errors" ]] && pass "no recent playback 400/rate-limit errors" && return
  fail "recent spotify_player playback errors: $errors"
}

main() {
  mark_log_position
  printf 'STATE %s\n' "$(state_line)"
  check_daemon
  check_playback_loaded
  check_routes
  check_play_pause
  check_volume
  check_recent_log_errors
  printf 'STATE %s\n' "$(state_line)"
  (( FAILURES == 0 )) || exit 1
}

main "$@"
