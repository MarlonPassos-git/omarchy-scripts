#!/usr/bin/env bash
set -euo pipefail

SPOTIFY_PLAYER_NAME=${SPOTIFY_PLAYER_NAME:-spotify_player}
SPOTIFY_PLAYER=${SPOTIFY_PLAYER:-$HOME/.local/opt/spotify-player-0.24.0/usr/bin/spotify_player}
SPOTIFY_COMMAND_TIMEOUT=${SPOTIFY_COMMAND_TIMEOUT:-8s}
SPOTIFY_CONFIG_FOLDER=${SPOTIFY_CONFIG_FOLDER:-$HOME/.config/spotify-player}
SPOTIFY_CACHE_FOLDER=${SPOTIFY_CACHE_FOLDER:-$HOME/.cache/spotify-player}
SPOTIFY_DAEMON_RESTART_WAIT_SECONDS=${SPOTIFY_DAEMON_RESTART_WAIT_SECONDS:-5}
SPOTIFY_LOG_TAIL_LINES=${SPOTIFY_LOG_TAIL_LINES:-160}
SPOTIFY_DEFAULT_PLAYBACK_LIMIT=${SPOTIFY_DEFAULT_PLAYBACK_LIMIT:-50}
SPOTIFY_MEDIA_KEY_LOG=${SPOTIFY_MEDIA_KEY_LOG:-$HOME/.cache/omarchy-scripts/spotify-media-key.jsonl}
SPOTIFY_VOLUME_LOCK=${SPOTIFY_VOLUME_LOCK:-$HOME/.cache/omarchy-scripts/spotify-volume.lock}
SPOTIFY_VOLUME_STATE=${SPOTIFY_VOLUME_STATE:-$HOME/.cache/omarchy-scripts/spotify-volume.state}
SPOTIFY_VOLUME_DEBOUNCE_SECONDS=${SPOTIFY_VOLUME_DEBOUNCE_SECONDS:-1}
SPOTIFY_VOLUME_STATE_TTL_MS=${SPOTIFY_VOLUME_STATE_TTL_MS:-2000}
SPOTIFY_MEDIA_KEY_COMMAND=""
SPOTIFY_MEDIA_KEY_ROUTE="unknown"
SPOTIFY_MEDIA_KEY_STARTED_AT_MS=0
SPOTIFY_DAEMON_RESTART_REASON="none"
SPOTIFY_DAEMON_HEALTH="unchecked"
SPOTIFY_DAEMON_COUNT="unknown"
SPOTIFY_DAEMON_RESTARTED=0

now_ms() {
  date +%s%3N
}

write_media_key_log() {
  local status="$1"
  local exit_code="$2"
  local finished_at_ms duration_ms restarted

  [[ "${SPOTIFY_MEDIA_KEY_DRY_RUN:-}" == "1" ]] && return
  [[ "$SPOTIFY_MEDIA_KEY_STARTED_AT_MS" =~ ^[0-9]+$ ]] || return
  finished_at_ms="$(now_ms)"
  duration_ms=$((finished_at_ms - SPOTIFY_MEDIA_KEY_STARTED_AT_MS))
  [[ "$SPOTIFY_DAEMON_RESTARTED" == "1" ]] && restarted=true || restarted=false
  mkdir -p "$(dirname "$SPOTIFY_MEDIA_KEY_LOG")"
  jq -cn --arg ts "$(date -Is)" --arg command "$SPOTIFY_MEDIA_KEY_COMMAND" --arg route "$SPOTIFY_MEDIA_KEY_ROUTE" --arg restart_reason "$SPOTIFY_DAEMON_RESTART_REASON" --arg daemon_health "$SPOTIFY_DAEMON_HEALTH" --arg daemon_count "$SPOTIFY_DAEMON_COUNT" --arg status "$status" --argjson duration_ms "$duration_ms" --argjson exit_code "$exit_code" --argjson daemon_restarted "$restarted" '{ts:$ts,command:$command,route:$route,status:$status,exit_code:$exit_code,duration_ms:$duration_ms,daemon_restarted:$daemon_restarted,restart_reason:$restart_reason,daemon_health:$daemon_health,daemon_count:$daemon_count}' >>"$SPOTIFY_MEDIA_KEY_LOG"
}

finish_media_key_log() {
  local exit_code="$?"
  local status="success"

  (( exit_code == 0 )) || status="failure"
  write_media_key_log "$status" "$exit_code" || true
}

execute_command() {
  if [[ "${SPOTIFY_MEDIA_KEY_DRY_RUN:-}" == "1" ]]; then
    printf '%q ' "$@"
    printf '\n'
    return
  fi

  "$@"
}

spotify_playback_json() {
  timeout "$SPOTIFY_COMMAND_TIMEOUT" "$SPOTIFY_PLAYER" --config-folder "$SPOTIFY_CONFIG_FOLDER" --cache-folder "$SPOTIFY_CACHE_FOLDER" get key playback 2>/dev/null || printf '{}'
}

spotify_mpris_status() {
  local status

  status="$(playerctl -p "$SPOTIFY_PLAYER_NAME" status 2>/dev/null || true)"
  printf '%s\n' "$status"
}

is_spotify_playing() {
  spotify_playback_json | jq -e '.is_playing == true' >/dev/null
}

is_spotify_mpris_playing() {
  [[ "$(spotify_mpris_status)" == "Playing" ]]
}

has_spotify_playback_item() {
  spotify_playback_json | jq -e '.item != null' >/dev/null
}

has_spotify_mpris_player() {
  [[ -n "$(spotify_mpris_status)" ]]
}

other_playing_player() {
  local player status
  while IFS= read -r player; do
    [[ -n "$player" && "$player" != "$SPOTIFY_PLAYER_NAME" && "$player" != "playerctld" ]] || continue
    status="$(playerctl -p "$player" status 2>/dev/null || true)"
    [[ "$status" == "Playing" ]] && printf '%s\n' "$player" && return 0
  done < <(playerctl -l 2>/dev/null || true)
  return 1
}

has_other_playing_player() {
  [[ -n "$(other_playing_player)" ]]
}

spotify_daemon_count() {
  pgrep -fc '(^|/)spotify_player --daemon$' || true
}

latest_spotify_log() {
  [[ -d "$SPOTIFY_CACHE_FOLDER" ]] || return 1
  find "$SPOTIFY_CACHE_FOLDER" -maxdepth 1 -name 'spotify-player-*.log' -printf '%T@ %p\n' 2>/dev/null |
    sort -nr | head -n 1 | cut -d' ' -f2-
}

recent_spotify_log_errors() {
  local log_file

  log_file="$(latest_spotify_log)"
  [[ -n "$log_file" && -f "$log_file" ]] || return 1
  tail -n "$SPOTIFY_LOG_TAIL_LINES" "$log_file" |
    grep -E -q 'GetCurrentPlayback.*Bad Request|Failed to handle a player request|Too Many Requests'
}

spotify_playback_responds_to_probe() {
  local playback

  playback="$(spotify_playback_json)"
  jq -e 'type == "object" and ((.is_playing | type == "boolean") or (.item != null) or (.device.volume_percent != null))' <<<"$playback" >/dev/null
}

run_other_player_command() {
  local player="$1"
  local command="$2"

  if [[ "${SPOTIFY_MEDIA_KEY_DRY_RUN:-}" == "1" ]]; then
    execute_command playerctl -p "$player" "$command"
    return
  fi

  playerctl -p "$player" "$command" >/dev/null 2>&1 || true
}

is_recoverable_spotify_error() {
  local output="$1"

  [[ "$output" == *"400 Bad Request"* ]] && return 0
  [[ "$output" == *"429 Too Many Requests"* ]] && return 0
  [[ "$output" == *"Failed to handle a player request"* ]]
}

restart_spotify_daemon() {
  local reason="${1:-unknown}"

  [[ "$SPOTIFY_DAEMON_RESTARTED" == "0" ]] || return 1
  command -v systemctl >/dev/null || return 1

  systemctl --user restart spotify-player.service >/dev/null 2>&1 || return 1
  SPOTIFY_DAEMON_RESTART_REASON="$reason"
  SPOTIFY_DAEMON_RESTARTED=1
  sleep "$SPOTIFY_DAEMON_RESTART_WAIT_SECONDS"
}

spotify_daemon_needs_recovery() {
  local count="$1"

  if [[ "$count" != "1" ]]; then
    SPOTIFY_DAEMON_HEALTH="daemon-count"
    return 0
  fi
  if recent_spotify_log_errors; then
    if spotify_playback_responds_to_probe; then
      SPOTIFY_DAEMON_HEALTH="recent-log-errors-playback-ok"
      return 1
    fi
    SPOTIFY_DAEMON_HEALTH="recent-log-errors"
    return 0
  fi
  SPOTIFY_DAEMON_HEALTH="ok"
  return 1
}

recover_spotify_daemon_for_keypress() {
  local count

  [[ "${SPOTIFY_MEDIA_KEY_DRY_RUN:-}" == "1" ]] && return
  count="$(spotify_daemon_count)"
  SPOTIFY_DAEMON_COUNT="$count"
  spotify_daemon_needs_recovery "$count" || return 0
  restart_spotify_daemon "preflight:$SPOTIFY_DAEMON_HEALTH" || true
}

run_spotify_cli_once() {
  timeout "$SPOTIFY_COMMAND_TIMEOUT" "$SPOTIFY_PLAYER" --config-folder "$SPOTIFY_CONFIG_FOLDER" --cache-folder "$SPOTIFY_CACHE_FOLDER" "$@"
}

run_spotify_cli_dry_run() {
  execute_command timeout "$SPOTIFY_COMMAND_TIMEOUT" "$SPOTIFY_PLAYER" --config-folder "$SPOTIFY_CONFIG_FOLDER" --cache-folder "$SPOTIFY_CACHE_FOLDER" "$@"
}

run_spotify_cli_with_recovery() {
  local output status

  output="$(run_spotify_cli_once "$@" 2>&1)" && { [[ -n "$output" ]] && printf '%s\n' "$output"; return 0; }
  status=$?
  if is_recoverable_spotify_error "$output" && restart_spotify_daemon "transport-error"; then
    run_spotify_cli_once "$@"
    return
  fi
  printf '%s\n' "$output" >&2
  return "$status"
}

run_spotify_cli() {
  if [[ "${SPOTIFY_MEDIA_KEY_DRY_RUN:-}" == "1" ]]; then
    run_spotify_cli_dry_run "$@"
    return
  fi

  run_spotify_cli_with_recovery "$@"
}

run_system_volume() {
  case "$1" in
    volume-up) execute_command omarchy-swayosd-client --output-volume raise ;;
    volume-down) execute_command omarchy-swayosd-client --output-volume lower ;;
    *) unsupported_command "$1" ;;
  esac
}

spotify_volume_percent() {
  spotify_playback_json | jq -r '.device.volume_percent // empty'
}

spotify_volume_percent_with_recovery() {
  local current

  current="$(spotify_volume_percent)"
  [[ "$current" =~ ^[0-9]+$ ]] && { printf '%s\n' "$current"; return 0; }
  restart_spotify_daemon "volume-playback-json" || return 1
  current="$(spotify_volume_percent)"
  [[ "$current" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$current"
}

clamp_volume() {
  local volume="$1"
  (( volume < 0 )) && volume=0
  (( volume > 100 )) && volume=100
  printf '%s\n' "$volume"
}

show_spotify_volume() {
  local volume="$1"
  local progress
  progress="$(awk -v volume="$volume" 'BEGIN { printf "%.2f", volume / 100 }')"
  execute_command omarchy-swayosd-client --custom-message Spotify --custom-icon audio-volume-high --custom-progress "$progress" --custom-progress-text "${volume}%"
}

read_recent_volume_state_target() {
  local updated_ms target age_ms

  [[ -f "$SPOTIFY_VOLUME_STATE" ]] || return 1
  read -r updated_ms target <"$SPOTIFY_VOLUME_STATE" || return 1
  [[ "$updated_ms" =~ ^[0-9]+$ && "$target" =~ ^[0-9]+$ ]] || return 1
  age_ms=$(($(now_ms) - updated_ms))
  ((age_ms <= SPOTIFY_VOLUME_STATE_TTL_MS)) || return 1
  printf '%s\n' "$target"
}

current_spotify_volume_for_target() {
  read_recent_volume_state_target || spotify_volume_percent_with_recovery
}

write_volume_state_target() {
  local target="$1"
  local updated_ms

  updated_ms="$(now_ms)"
  printf '%s %s\n' "$updated_ms" "$target" >"$SPOTIFY_VOLUME_STATE"
  printf '%s %s\n' "$updated_ms" "$target"
}

update_spotify_volume_target() {
  local command="$1"
  local current target

  current="$(current_spotify_volume_for_target)"
  [[ "$current" =~ ^[0-9]+$ ]] || return 1
  [[ "$command" == "volume-up" ]] && target=$((current + 5)) || target=$((current - 5))
  target="$(clamp_volume "$target")"
  write_volume_state_target "$target"
}

flush_spotify_volume_after_debounce() {
  local expected_ms="$1"
  local expected_target="$2"
  local current_ms current_target

  trap - EXIT
  sleep "$SPOTIFY_VOLUME_DEBOUNCE_SECONDS"
  read -r current_ms current_target <"$SPOTIFY_VOLUME_STATE" || return 0
  [[ "$current_ms" == "$expected_ms" && "$current_target" == "$expected_target" ]] || return 0
  run_spotify_cli playback volume "$expected_target" >/dev/null 2>&1 || true
}

schedule_spotify_volume_flush() {
  local updated_ms="$1"
  local target="$2"

  flush_spotify_volume_after_debounce "$updated_ms" "$target" >/dev/null 2>&1 &
}

run_spotify_volume() {
  local command="$1"
  local lock_fd state_line updated_ms target

  [[ "${SPOTIFY_MEDIA_KEY_DRY_RUN:-}" == "1" ]] && { run_spotify_cli playback volume 70; return; }
  mkdir -p "$(dirname "$SPOTIFY_VOLUME_LOCK")" "$(dirname "$SPOTIFY_VOLUME_STATE")"
  exec {lock_fd}>"$SPOTIFY_VOLUME_LOCK"
  flock -w 1 "$lock_fd" || { SPOTIFY_MEDIA_KEY_ROUTE="spotify-volume-throttled"; return 0; }
  state_line="$(update_spotify_volume_target "$command")" || return 1
  read -r updated_ms target <<<"$state_line"
  flock -u "$lock_fd"
  exec {lock_fd}>&-
  show_spotify_volume "$target" || true
  schedule_spotify_volume_flush "$updated_ms" "$target"
}

start_default_spotify_playback() {
  SPOTIFY_MEDIA_KEY_ROUTE="spotify-start-liked"
  run_spotify_cli playback start liked --limit "$SPOTIFY_DEFAULT_PLAYBACK_LIMIT"
}

ensure_spotify_playback_loaded() {
  local command="$1"

  case "$command" in
    play | play-pause | next | previous)
      has_spotify_playback_item && return 0
      start_default_spotify_playback
      return 1
      ;;
    *) return 0 ;;
  esac
}

rehydrate_spotify_playback_after_skip() {
  local command="$1"

  case "$command" in
    next | previous) has_spotify_playback_item || start_default_spotify_playback ;;
    *) return 0 ;;
  esac
}

spotify_has_focus() {
  is_spotify_playing && return 0
  is_spotify_mpris_playing && return 0
  has_spotify_playback_item && ! has_other_playing_player && return 0
  has_spotify_mpris_player && ! has_other_playing_player
}

should_use_spotify() {
  local command="$1"

  case "$command" in
    play | pause | play-pause | previous | next | volume-up | volume-down) spotify_has_focus ;;
    *) is_spotify_playing || is_spotify_mpris_playing ;;
  esac
}

run_native_command() {
  local command="$1"
  local player

  SPOTIFY_MEDIA_KEY_ROUTE="native"
  case "$command" in
    volume-up | volume-down) run_system_volume "$command" ;;
    previous | next | play-pause)
      player="$(other_playing_player || true)"
      [[ -n "$player" ]] && SPOTIFY_MEDIA_KEY_ROUTE="playerctl:$player" && run_other_player_command "$player" "$command" && return
      execute_command omarchy-swayosd-client --playerctl "$command"
      ;;
    play | pause) execute_command omarchy-swayosd-client --playerctl play-pause ;;
    *) unsupported_command "$command" ;;
  esac
}

run_spotify_command() {
  local command="$1"

  SPOTIFY_MEDIA_KEY_ROUTE="spotify"
  case "$command" in
    volume-up | volume-down) run_spotify_volume "$command" || return 0 ;;
    play | play-pause | next | previous)
      ensure_spotify_playback_loaded "$command" || return 0
      run_spotify_cli playback "$command"
      rehydrate_spotify_playback_after_skip "$command"
      ;;
    pause) run_spotify_cli playback "$command" ;;
    *) unsupported_command "$command" ;;
  esac
}

unsupported_command() {
  local command="$1"
  printf 'unsupported spotify media command: %s (expected play-pause|play|pause|next|previous|volume-up|volume-down)\n' "$command" >&2
  exit 2
}

main() {
  local command="${1:-}"

  SPOTIFY_MEDIA_KEY_STARTED_AT_MS="$(now_ms)"
  SPOTIFY_MEDIA_KEY_COMMAND="${command:-<empty>}"
  trap finish_media_key_log EXIT
  [[ -n "$command" ]] || unsupported_command "<empty>"
  recover_spotify_daemon_for_keypress
  if should_use_spotify "$command" && run_spotify_command "$command"; then
    return
  fi

  run_native_command "$command"
}

main "$@"
