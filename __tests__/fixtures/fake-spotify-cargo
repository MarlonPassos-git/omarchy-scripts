#!/usr/bin/env bash
set -euo pipefail

root=""
version=""
features=""
while (($#)); do
  case "$1" in
    --root) root="$2"; shift 2 ;;
    --version) version="$2"; shift 2 ;;
    --features) features="$2"; shift 2 ;;
    *) shift ;;
  esac
done

printf '%s\n' "$features" >>"$FAKE_CARGO_LOG"
mkdir -p "$root/bin"
{
  printf '%s\n' '#!/usr/bin/env bash'
  printf 'VERSION=%q\n' "$version"
  printf 'FEATURES=%q\n' "$features"
  printf '%s\n' \
    'feature_enabled() {' \
    '  [[ ",$FEATURES," == *",$1,"* ]] && return 0' \
    '  [[ "$1" == "streaming" && ",$FEATURES," == *",daemon,"* ]] && return 0' \
    '  [[ "$1" == "streaming" && ",$FEATURES," == *",pulseaudio-backend,"* ]]' \
    '}' \
    '' \
    'case "${1:-}" in' \
    '  --version)' \
    '    [[ "${FAKE_CARGO_BAD_VERSION:-0}" == "1" ]] && VERSION="0.0.0"' \
    '    printf "spotify_player %s\\n" "$VERSION"' \
    '    ;;' \
    '  features)' \
    '    for feature in daemon streaming media-control image sixel notify fzf pulseaudio-backend; do' \
    '      feature_enabled "$feature" && printf "  ✓ %s\\n" "$feature" || printf "  ✗ %s\\n" "$feature"' \
    '    done' \
    '    ;;' \
    'esac'
} >"$root/bin/spotify_player"
chmod +x "$root/bin/spotify_player"
