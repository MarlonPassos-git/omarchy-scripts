#!/usr/bin/env bash
set -euo pipefail

SPOTIFY_PLAYER_RELEASE="${SPOTIFY_PLAYER_RELEASE:-0.24.1}"
SPOTIFY_FULL_FEATURES="daemon,media-control,image,sixel,notify,fzf,pulseaudio-backend"
SPOTIFY_TUI_FEATURES="image,sixel,fzf"
SPOTIFY_OPT_ROOT="${SPOTIFY_OPT_ROOT:-$HOME/.local/opt}"
SPOTIFY_BIN_ROOT="${SPOTIFY_BIN_ROOT:-$HOME/.local/bin}"
CARGO_COMMAND="${CARGO_COMMAND:-cargo}"
TEMP_PATHS=()

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

require_safe_absolute_root() {
  local path="$1"

  [[ "$path" == /* && "$path" != "/" && "$path" != "$HOME" ]] ||
    fail "unsafe install root <$path>; expected an absolute child directory outside HOME root"
}

spotify_profile_dir() {
  local profile="$1"

  printf '%s/spotify-player%s-%s\n' \
    "$SPOTIFY_OPT_ROOT" "$profile" "$SPOTIFY_PLAYER_RELEASE"
}

spotify_profile_binary() {
  local profile="$1"

  printf '%s/usr/bin/spotify_player\n' "$(spotify_profile_dir "$profile")"
}

binary_matches_profile() {
  local binary="$1" required_features="$2" forbidden_features="$3" output feature
  [[ -x "$binary" ]] || return 1
  [[ "$("$binary" --version 2>/dev/null)" == "spotify_player $SPOTIFY_PLAYER_RELEASE" ]] || return 1
  output="$("$binary" features 2>/dev/null)" || return 1

  for feature in ${required_features//,/ }; do
    grep -Fq "✓ $feature" <<<"$output" || return 1
  done
  for feature in ${forbidden_features//,/ }; do
    ! grep -Fq "✓ $feature" <<<"$output" || return 1
  done
}

build_spotify_profile() {
  local profile="$1" features="$2" required="$3" forbidden="$4"
  local build_root source_binary target_binary staged_binary
  build_root="$(mktemp -d /tmp/omarchy-spotify-player.XXXXXX)"
  TEMP_PATHS+=("$build_root")
  "$CARGO_COMMAND" install spotify_player --version "$SPOTIFY_PLAYER_RELEASE" \
    --locked --root "$build_root" --no-default-features --features "$features"
  source_binary="$build_root/bin/spotify_player"
  binary_matches_profile "$source_binary" "$required" "$forbidden" ||
    fail "invalid built binary <$source_binary>; expected profile <$profile> for version <$SPOTIFY_PLAYER_RELEASE>"

  target_binary="$(spotify_profile_binary "$profile")"
  staged_binary="${target_binary}.new.$$"
  TEMP_PATHS+=("$staged_binary")
  mkdir -p "$(dirname "$target_binary")"
  install -m 0755 "$source_binary" "$staged_binary"
  mv -f "$staged_binary" "$target_binary"
}

ensure_spotify_profile() {
  local profile="$1" features="$2" required="$3" forbidden="$4" binary
  binary="$(spotify_profile_binary "$profile")"

  if binary_matches_profile "$binary" "$required" "$forbidden"; then
    printf 'Keeping valid Spotify %s binary: %s\n' "${profile:-full}" "$binary"
    return
  fi

  build_spotify_profile "$profile" "$features" "$required" "$forbidden"
  binary_matches_profile "$binary" "$required" "$forbidden" ||
    fail "invalid installed binary <$binary>; expected profile <${profile:-full}>"
}

install_spotify_command_link() {
  local command_link="$SPOTIFY_BIN_ROOT/spotify_player" full_binary
  full_binary="$(spotify_profile_binary "")"
  mkdir -p "$SPOTIFY_BIN_ROOT"
  if [[ -e "$command_link" && ! -L "$command_link" ]]; then
    fail "existing command <$command_link>; expected a symlink or missing path"
  fi
  ln -sfn "$full_binary" "$command_link"
}

remove_obsolete_profile_dirs() {
  local full_dir tui_dir candidate
  full_dir="$(spotify_profile_dir "")"
  tui_dir="$(spotify_profile_dir "-tui")"

  while IFS= read -r -d '' candidate; do
    [[ "$candidate" == "$SPOTIFY_OPT_ROOT"/spotify-player-[0-9]* ||
      "$candidate" == "$SPOTIFY_OPT_ROOT"/spotify-player-tui-[0-9]* ]] ||
      fail "unsafe cleanup target <$candidate>; expected a versioned Spotify profile directory"
    rm -rf -- "$candidate"
    printf 'Removed obsolete Spotify profile: %s\n' "$candidate"
  done < <(find "$SPOTIFY_OPT_ROOT" -mindepth 1 -maxdepth 1 -type d \
    \( -name 'spotify-player-[0-9]*' -o -name 'spotify-player-tui-[0-9]*' \) \
    ! -path "$full_dir" ! -path "$tui_dir" -print0)
}

is_legacy_spotify_wrapper() {
  local path="$1"

  [[ -f "$path" && ! -L "$path" ]] || return 1
  grep -Eq 'spotify_player|spotify-player|omarchy-spotify' "$path"
}

remove_legacy_spotify_wrappers() {
  local wrapper_name candidate
  local wrapper_names=(spotify spotify-tui spotify-media-key spotify-debug-state spotify-validate-controls)

  for wrapper_name in "${wrapper_names[@]}"; do
    while IFS= read -r -d '' candidate; do
      is_legacy_spotify_wrapper "$candidate" || continue
      rm -f -- "$candidate"
      printf 'Removed legacy Spotify wrapper: %s\n' "$candidate"
    done < <(find "$SPOTIFY_BIN_ROOT" -mindepth 1 -maxdepth 1 -type f \
      \( -name "$wrapper_name" -o -name "$wrapper_name.bak-*" \) -print0)
  done
}

cleanup_temporary_paths() {
  local path

  for path in "${TEMP_PATHS[@]}"; do
    [[ "$path" == /tmp/omarchy-spotify-player.* || "$path" == *.new.$$ ]] || continue
    rm -rf -- "$path"
  done
}

main() {
  require_safe_absolute_root "$SPOTIFY_OPT_ROOT"
  require_safe_absolute_root "$SPOTIFY_BIN_ROOT"
  ensure_spotify_profile "" "$SPOTIFY_FULL_FEATURES" \
    "daemon,streaming,media-control,image,sixel,notify,fzf,pulseaudio-backend" ""
  ensure_spotify_profile "-tui" "$SPOTIFY_TUI_FEATURES" \
    "image,sixel,fzf" "daemon,streaming"
  install_spotify_command_link
  remove_obsolete_profile_dirs
  remove_legacy_spotify_wrappers
  printf 'Installed Spotify player %s full and control-only profiles.\n' "$SPOTIFY_PLAYER_RELEASE"
}

trap cleanup_temporary_paths EXIT
main "$@"
